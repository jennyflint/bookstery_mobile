{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*"],
      "@/*": ["app/*"],
      "~~/*": ["*"],
      "@@/*": ["*"]
    }
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "composables/**/*",
    "pages/**/*",
    "plugins/**/*",
    "services/**/*",
    "stores/**/*",
    "types/**/*",
    "tests/**/*"
  ]
}
